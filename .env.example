VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:3000
# Google Maps browser key (Maps JavaScript API + Places API).
# Restringila por HTTP referrer y por API en GCP Console.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Opcional: Map ID para Advanced Markers. Por defecto usa DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
